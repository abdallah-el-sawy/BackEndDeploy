<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Numbers</title>
  </head>
  <style>
    p{
      background-color: aqua;
      padding: 10px;
      border-radius: 10px;
      font-size: larger;
    }
  </style>
  <body>
    <h1>Hello <%=name%></h1>
    <p><%=numbers%></p>


    <% if(name == "sawy"){ %>
    <div style="background-color: blue; color: bisque; font-size: large; font-weight: 700;">I am sawy</div>
    <% } %>

    <% if(name == "abdallah"){ %>
    <div style="background-color: blue; color: bisque; font-size: large; font-weight: 700;">I am abdallah</div>
    <% } %>

  </body>
</html>
